# Copy to .env for local development, and set the same three in Railway.
#
# Vite inlines VITE_* variables into the bundle at BUILD time, not runtime.
# On Railway they must exist before the build step runs, and changing one
# requires a redeploy — restarting the service is not enough.
#
# All three end up readable in the shipped JavaScript. That is expected for
# the Supabase pair (the anon key is designed to be public and RLS is the
# real security boundary), but it means the Google key must be restricted by
# HTTP referrer in Google Cloud Console or anyone can spend your quota.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_BOOKS_KEY=your-google-books-key
